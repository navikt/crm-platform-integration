{
    "private": true,
    "scripts": {
        "scratch-org": "node bin/create-scratch-org.js",
        "test:node": "node --test bin/tests/*test.js",
        "test:scratch-org": "npm run test:node && bash bin/tests/create-scratch-org.test.sh",
        "test:dependency-report": "jest --config bin/tests/package-dependency-report.jest.config.cjs --runInBand",
        "test:scratch-org:powershell": "pwsh -NoLogo -NoProfile -File bin/tests/create-scratch-org.Tests.ps1",
        "test": "npm run test:unit",
        "test:unit": "sfdx-lwc-jest",
        "test:unit:watch": "sfdx-lwc-jest --watch",
        "test:unit:debug": "sfdx-lwc-jest --debug",
        "test:unit:coverage": "sfdx-lwc-jest --coverage",
        "prettier:write": "prettier --write \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
        "prettier:check": "prettier --check --no-error-on-unmatched-pattern \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
        "prepare": "husky",
        "precommit": "lint-staged",
        "lint-staged": "lint-staged"
    },
    "devDependencies": {
        "@prettier/plugin-xml": "3.4.2",
        "husky": "9.1.7",
        "jest": "29.7.0",
        "jest-environment-jsdom": "29.7.0",
        "lint-staged": "16.3.3",
        "prettier": "3.8.1",
        "prettier-plugin-apex": "2.2.6"
    },
    "lint-staged": {
        "**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}": [
            "prettier --write --ignore-path .gitignore --ignore-path .prettierignore"
        ]
    }
}
