#!/usr/bin/env sh
set -eu

if [ "${ALLOW_PACKAGE_DIR_COMMIT:-0}" != "1" ]; then
  if ! command -v jq >/dev/null 2>&1; then
    echo "Error: jq is required for the pre-commit policy (not found in PATH)."
    exit 1
  fi

  blocked_paths_regex=$(jq -r '
    [
      .packageDirectories[]?.path
      | select(type == "string" and . != "force-app")
      | gsub("([.^$|()\\[\\]{}*+?\\\\])"; "\\\\\\1")
    ]
    | if length > 0 then
        "^(" + join("|") + ")/"
      else
        "^$"
      end
  ' sfdx-project.json)

  blocked_paths=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "$blocked_paths_regex" || true)

  if [ -n "$blocked_paths" ]; then
    echo "Error: commit blocked. Staged changes in package/reference directories are not allowed by the pre-commit policy."
    echo
    echo "Staged files that violate the policy:"
    echo "$blocked_paths"
    echo
    echo "Unstage these files, for example:"
    echo "  git restore --staged <file>"
    echo
    echo "For an explicitly approved emergency exception:"
    echo "  ALLOW_PACKAGE_DIR_COMMIT=1 git commit ..."
    exit 1
  fi
fi

npm run lint-staged
